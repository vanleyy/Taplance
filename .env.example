# -----------------------------------------------------------------------------
# Taplance — Supabase environment configuration
# -----------------------------------------------------------------------------
# To switch between production and development, Next.js loads env files based on
# NODE_ENV. `.env.local` always overrides, then `.env.production` /
# `.env.development`, then `.env`. Nothing here is hardcoded in the app — every
# value is read from process.env, so swapping these files swaps the backend.
#
#   Production   ->  set values in .env (or .env.production)
#   Development  ->  copy this block into .env.development (or .env.local)
#
# Each Supabase project must ALSO have Google OAuth configured and your
# redirect URLs allowlisted (http://localhost:3000/auth/callback in dev,
# https://your-domain/auth/callback in prod).

# ---- Shared ----------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ilodslsrfhrsgefodtbv.supabase.co

# Supabase anon (publishable) key — starts with "eyJ..." (JWT). Never use the
# service_role key in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Username shown by the "Preview" button on the landing page. Point this at a
# profile that exists in the active database.
NEXT_PUBLIC_DEMO_USERNAME=hackedsdq

# ---- Development override --------------------------------------------------
# Copy the values above into `.env.development` and replace with your dev
# Supabase project (e.g. https://your-dev-project.supabase.co) and its anon key.
